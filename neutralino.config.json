{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.emberlands.game",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 41733,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "Emberlands",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 560,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "emberlands",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
