{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emberlands",
  "version": "1.0.0",
  "identifier": "com.emberlands.game",
  "build": {
    "frontendDist": "../resources",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run desktop:sync"
  },
  "app": {
    "windows": [
      {
        "title": "Emberlands",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
